# Frontend configuration.
#
# VITE_ variables are baked into the bundle at BUILD time, not read at
# container start -- so these are build args in the Dockerfile, and the deploy
# workflow asserts the key is non-empty before building. A missing one
# produces an empty string with no error.
#
# There is deliberately no VITE_API_URL: the app is served same-origin behind
# the shared proxy and calls /api directly. See src/api/config.js.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# The CRM's address, for the navbar link that opens it with the same user
# still signed in (see src/components/Navbar.jsx). Empty hides the link, which
# is correct only where the CRM does not run. It now runs in BOTH deployed
# environments -- `api-testing` on test, `crm` on prod -- so both workflows set
# it, and a bundle built without it silently loses the link. Set as a literal in
# each deploy workflow rather than a GitHub variable: it is a fact about the
# topology, and a literal cannot quietly go missing.
#
# The hop keeps the user signed in because both apps share one Clerk instance
# and both hostnames sit under one parent domain, so the session cookie is
# already shared. See the comment on the build job in deploy-prod.yml.
VITE_CRM_URL=https://api-testing.max-cpa.co.il # optional
