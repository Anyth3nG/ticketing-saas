# Python
__pycache__/
*.pyc
backend/venv/

# Environment
.env
*.local

# Deploy artefacts. The .env pattern above matches a file named exactly
# ".env", so these need naming: they hold real secrets, are rendered by CI or
# by deploy.sh on the box, and must never be committed.
deploy/backend.env
deploy/stack.env
deploy/proxy-conf.d/
deploy/proxy-templates/

# Node
node_modules/
dist/
dist-ssr/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Claude
frontend/.agents/
frontend/skills-lock.json

# Editor
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
